# Port d'écoute sur la machine hôte (accessible via http://votre-serveur:3030)
PORT=3030

# (Optionnel) Protection de l'espace Équipes & Administration
# Par défaut, l'accès est libre et non protégé.
# Décommentez pour activer une protection par mot de passe ou code PIN :
# ADMIN_PASSWORD=supersecret
# ADMIN_PIN=1234
